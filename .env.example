# ── Models ─────────────────────────────────────────────
# openai = testing. openrouter = destination.
MODEL_BACKEND=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── GoHighLevel ────────────────────────────────────────
# Copy from invoice_automation/.env
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
GHL_USER_ID=

# ── Google ─────────────────────────────────────────────
# base64 -i service_account.json | tr -d '\n'
GOOGLE_CREDENTIALS_B64=
GOOGLE_CALENDAR_ID=
GOOGLE_MAPS_API_KEY=

# ── Business config ────────────────────────────────────
DEPOSIT_AMOUNT=50

# ── Google Chat (production interface) ─────────────────
# Service account for the Chat app. Leave blank to reuse
# GOOGLE_CREDENTIALS_B64 (correct if it's the same account).
GOOGLE_CHAT_CREDENTIALS_B64=

# Must match "Authentication Audience" in the Chat API config:
#   App URL         -> https://<your-app>.up.railway.app/google-chat
#   Project Number  -> the numeric GCP project number
GOOGLE_CHAT_AUDIENCE=

# Only ever false for local testing with a fake payload. An unverified
# webhook lets anyone on the internet book real jobs.
CHAT_VERIFY_REQUESTS=true

# Where paused bookings are stored on the server.
# On Railway, point this at a mounted volume or it resets every deploy.
CHECKPOINT_DB=/data/agent_threads.sqlite

# ── Browser UI in production ───────────────────────────
# Blank = the UI is not served at all (recommended).
# Set to a long random string to enable it at /?token=...
WEB_UI_TOKEN=

# ── Safety ─────────────────────────────────────────────
# true  = log payloads, never write to GHL/Calendar
# false = LIVE. real contacts, real invoices, real emails.
DRY_RUN=true

# ── Observability ──────────────────────────────────────
# A trace is a recording of one turn: which node ran, what the
# model was asked and answered, how long each step took, and
# every GHL / Calendar / Maps / Vision call underneath.
# Read them at https://smith.langchain.com
#
# ⚠️  OFF BY DEFAULT ON PURPOSE. Tracing uploads run contents to
# LangSmith's servers — for this agent that is real customer
# names, phone numbers, email addresses, home addresses and the
# screenshots of their conversations. Turn it on deliberately.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Use DIFFERENT projects for local and Railway, or your test
# runs and real bookings end up in one undifferentiated list.
#   local   -> splendid-ops-agent-dev
#   Railway -> splendid-ops-agent
LANGSMITH_PROJECT=splendid-ops-agent

# Keep the timings and the shape of each run, drop the contents.
# Useful for watching live traffic without uploading customer
# data — but it also strips the extraction output, which is
# usually the thing you opened the trace to read.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
